    "                   text=f\"<span style='font-size:20px'><b>{len(base):,}</b></span><br><span style='font-size:11px;color:{MUTED}'>customers</span>\")\n",
    "\n",
    "t = base.groupby(\"tenure_group\")[\"Churn_bin\"].mean().mul(100).reindex(bands)\n",
    "xa, ya = panel(*COL[2], *R2, \"Churn by tenure\", f\"{t.iloc[0]:.0f}% in the first year vs {t.iloc[-1]:.0f}% after year four\",\n",
    "               yaxis=dict(ticksuffix=\"%\", range=[0, t.max() * 1.25]))\n",
    "fig.add_trace(go.Bar(x=t.index, y=t.values, marker_color=[RED, ORANGE, AMBER, GREEN], text=t.values.round(1), texttemplate=\"%{text}%\",\n",
    "                     textposition=\"outside\", cliponaxis=False, hovertemplate=\"%{x}: %{y:.1f}%<extra></extra>\", xaxis=xa, yaxis=ya))\n",
    "\n",
    "top = drivers[\"mean_abs_shap\"].head(10)[::-1]\n",
    "xa, ya = panel(*COL[0], *R3, \"Top 10 churn drivers\", \"Mean |SHAP|: average impact on churn log-odds\", room=0.13,\n",
    "               xaxis=dict(showgrid=True, gridcolor=GRID), yaxis=dict(showgrid=False, tickfont=dict(size=10, color=TEXT)))\n",
    "fig.add_trace(go.Bar(x=top.values, y=[pretty(n) for n in top.index], orientation=\"h\",\n",
    "                     marker=dict(color=top.values, colorscale=[[0, ORANGE], [1, RED]]),\n",
    "                     hovertemplate=\"%{y}: %{x:.3f}<extra></extra>\", xaxis=xa, yaxis=ya))\n",
    "\n",
    "xa, ya = panel(*COL[1], *R3, \"Lift by decile\", f\"Riskiest 30% capture {lift.loc[2, 'cum_coverage']:.0f}% of cancellations (line = cumulative %)\",\n",
    "               xaxis=dict(dtick=1, title=dict(text=\"Risk decile (1 = highest risk)\", font=dict(size=11, color=MUTED))),\n",
    "               yaxis=dict(title=dict(text=\"Lift\", font=dict(size=11, color=MUTED)), ticksuffix=\"x\", range=[0, lift[\"lift\"].max() * 1.2]))\n",
