    "                     hovertemplate=\"Decile %{x}: %{y:.2f}x<extra></extra>\", xaxis=xa, yaxis=ya))\n",
    "axes[0] += 1\n",
    "y2 = f\"y{axes[0]}\"\n",
    "fig.update_layout({f\"yaxis{axes[0]}\": dict(overlaying=ya, anchor=xa, side=\"right\", showgrid=False, zeroline=False, range=[0, 108], tickvals=[0, 25, 50, 75, 100],\n",
    "                                          ticktext=[\"0%\", \"25%\", \"50%\", \"75%\", \"100%\"], tickfont=dict(size=11, color=MUTED))})\n",
