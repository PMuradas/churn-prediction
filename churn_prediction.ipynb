   "source": [
    "## How many customers should be approached?\n",
    "\n",
    "The answer depends on how well the actions work and on the size of the campaign. For each success rate, this is the share of the base (riskiest first) that gives the best profit:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1430904d",
   "metadata": {},
   "outputs": [],
   "source": [
    "ranked = base.sort_values(\"churn_prob\", ascending=False).reset_index(drop=True)\n",
    "value_ranked = customer_value(ranked[\"MonthlyCharges\"]).values\n",
    "churn_ranked = ranked[\"Churn_bin\"].values\n",
    "\n",
    "shares = np.arange(5, 55, 5)\n",
    "rates = [0.10, 0.20, 0.30, 0.35, 0.40, 0.50]\n",
    "roi = pd.DataFrame({f\"{s}%\": [(r * value_ranked[:n] * churn_ranked[:n]).sum() - n * ACTION_COST\n",
    "                              for r in rates for n in [int(len(ranked) * s / 100)]] for s in shares},\n",
    "                   index=[f\"{r:.0%}\" for r in rates])\n",
    "roi.index.name = \"success rate\"\n",
    "\n",
    "best = pd.DataFrame({\"best share of the base\": roi.idxmax(axis=1), \"net profit (US$)\": roi.max(axis=1)})\n",
    "best.loc[best[\"net profit (US$)\"] <= 0, \"best share of the base\"] = \"not worth it\"\n",
    "best.style.format({\"net profit (US$)\": \"{:,.0f}\"})"
   ]
  },
