  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b2a05269",
   "metadata": {},
   "outputs": [],
   "source": [
    "churn_rate      = base[\"Churn_bin\"].mean() * 100\n",
    "revenue_at_risk = base.loc[base[\"Churn_bin\"] == 1, \"MonthlyCharges\"].sum()\n",
    "n_target        = int(base[\"risk\"].isin([\"Critical\", \"High\"]).sum())\n",
    "total_profit    = plan[\"net_profit\"].sum()\n",
    "auc_test        = roc_auc_score(y_test, proba_test)\n",
    "\n",
    "fig = go.Figure()\n",
    "axes = [0]\n",
    "\n",
    "def style_axes(i, x0, x1, y0, y1, xaxis=None, yaxis=None):\n",
    "    s = \"\" if i == 1 else str(i)\n",
    "    common = dict(zeroline=False, showline=False, tickfont=dict(size=11, color=MUTED))\n",
    "    fig.update_layout({\n",
    "        f\"xaxis{s}\": {**common, \"domain\": [x0, x1], \"anchor\": f\"y{s}\", \"showgrid\": False, **(xaxis or {})},\n",
    "        f\"yaxis{s}\": {**common, \"domain\": [y0, y1], \"anchor\": f\"x{s}\", \"gridcolor\": GRID, **(yaxis or {})},\n",
    "    })\n",
    "    return f\"x{s}\", f\"y{s}\"\n",
    "\n",
    "def header(x0, y1, title, subtitle):\n",
    "    fig.add_annotation(xref=\"paper\", yref=\"paper\", x=x0, y=y1 + 0.012, xanchor=\"left\", yanchor=\"bottom\", showarrow=False, align=\"left\",\n",
    "                       text=f\"<b>{title}</b><br><span style='font-size:11px;color:{MUTED}'>{subtitle}</span>\", font=dict(size=14, color=TEXT))\n",
    "\n",
    "def panel(x0, x1, y0, y1, title, subtitle, room=0.0, xaxis=None, yaxis=None):\n",
    "    axes[0] += 1\n",
    "    header(x0, y1, title, subtitle)\n",
    "    return style_axes(axes[0], x0 + room, x1, y0, y1, xaxis, yaxis)\n",
    "\n",
    "def kpi(x0, x1, y0, y1, value, title, color, **number):\n",
    "    for ya, yb, fill in [(y0, y1, \"#F5F7FA\"), (y1 - 0.004, y1, color)]:\n",
    "        fig.add_shape(type=\"rect\", xref=\"paper\", yref=\"paper\", x0=x0, x1=x1, y0=ya, y1=yb, fillcolor=fill, line_width=0, layer=\"below\")\n",
    "    fig.add_trace(go.Indicator(mode=\"number\", value=value, number=dict(font=dict(size=38, color=color), **number),\n",
    "                               title=dict(text=title, font=dict(size=13, color=MUTED)),\n",
    "                               domain=dict(x=[x0, x1], y=[y0, y1 - 0.012])))\n",
    "\n",
    "def pretty(name):\n",
    "    for c in cat_cols:\n",
    "        if name.startswith(c + \"_\"):\n",
    "            return f\"{c}: {name[len(c) + 1:]}\"\n",
    "    return name.replace(\"_\", \" \")\n",
    "\n",
    "gap = 0.045\n",
    "cw = (1 - 2 * gap) / 3\n",
    "COL = [(i * (cw + gap), i * (cw + gap) + cw) for i in range(3)]\n",
    "KPI_Y, R2, R3, R4 = (0.858, 0.925), (0.600, 0.780), (0.335, 0.515), (0.070, 0.250)\n",
    "\n",
    "kw = (1 - 3 * 0.02) / 4\n",
    "for i, (value, title, color, fmt) in enumerate([\n",
