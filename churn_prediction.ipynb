    "                     marker=dict(colors=[GREEN, AMBER, ORANGE, RED], line=dict(color=\"white\", width=2)),\n",
    "                     textinfo=\"label+percent\", textfont=dict(size=11), automargin=True,\n",
    "                     hovertemplate=\"%{label}: %{value:,} customers<extra></extra>\",\n",
