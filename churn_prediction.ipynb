    "        (total_profit, f\"Net campaign profit ({n_target:,} target customers)\", GREEN, dict(prefix=\"US$ \", valueformat=\",.0f\")),\n",
    "        (auc_test, \"Model ROC-AUC (test set)\", NAVY, dict(valueformat=\".3f\"))]):\n",
    "    kpi(i * (kw + 0.02), i * (kw + 0.02) + kw, *KPI_Y, value, title, color, **fmt)\n",
    "\n",
    "t = base.groupby(\"Contract\")[\"Churn_bin\"].mean().mul(100).sort_values()\n",
    "xa, ya = panel(*COL[0], *R2, \"Churn by contract type\", f\"Month-to-month: {t.max():.0f}% vs {t.min():.0f}% on two-year plans\",\n",
    "               yaxis=dict(ticksuffix=\"%\", range=[0, t.max() * 1.25]))\n",
    "fig.add_trace(go.Bar(x=t.index, y=t.values, marker_color=[GREEN, AMBER, RED], text=t.values.round(1), texttemplate=\"%{text}%\",\n",
    "                     textposition=\"outside\", cliponaxis=False, hovertemplate=\"%{x}: %{y:.1f}%<extra></extra>\", xaxis=xa, yaxis=ya))\n",
    "\n",
    "rc = base[\"risk\"].value_counts().reindex([\"Low\", \"Medium\", \"High\", \"Critical\"])\n",
